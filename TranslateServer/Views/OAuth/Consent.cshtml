@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Authorization Request</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 480px; margin: 60px auto; padding: 20px; }
        .card { border: 1px solid #ddd; border-radius: 8px; padding: 24px; }
        .buttons { margin-top: 24px; display: flex; gap: 12px; }
        button { padding: 10px 20px; font-size: 16px; cursor: pointer; }
        .allow { background: #0d6efd; color: white; border: none; }
        .deny { background: #6c757d; color: white; border: none; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Authorization Request</h2>
        <p><strong>@ViewBag.ClientName</strong> wants to access your MCP server.</p>
        <p>Requested scope: <code>@ViewBag.Scope</code></p>
        
        <form method="post" action="/api/oauth/authorize">
            <input type="hidden" name="client_id" value="@ViewBag.ClientId" />
            <input type="hidden" name="redirect_uri" value="@ViewBag.RedirectUri" />
            <input type="hidden" name="state" value="@ViewBag.State" />
            <input type="hidden" name="code_challenge" value="@ViewBag.CodeChallenge" />
            <input type="hidden" name="code_challenge_method" value="@ViewBag.CodeChallengeMethod" />

            <div class="buttons">
                <button type="submit" name="action" value="allow" class="allow">Allow</button>
                <button type="submit" name="action" value="deny" class="deny">Deny</button>
            </div>
        </form>
    </div>
</body>
</html>
