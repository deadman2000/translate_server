{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Information"
    }
  },
  "ConnectionStrings": {
    "Mongo": "mongodb://root:example@localhost",
    "Elastic": "http://localhost:9200"
  },
  "Server": {
    "ProjectsDir": "projects"
  },
  "Mcp": {
    "Enabled": true,

    // Static token agents (works with LM Studio, custom clients, etc.)
    "Agents": [
      {
        "Token": "dev-mcp-token-change-me-in-production",
        "AgentName": "Claude-3.5",
        "Description": "Primary development agent (full access)"
      },
      {
        "Token": "readonly-audit-token-999",
        "AgentName": "Audit-Bot",
        "Description": "Read-only agent for analysis",
        "ReadOnly": true
      }
    ],

    // JWT / OAuth support (required for Grok and other OAuth MCP clients)
    "Jwt": {
      "Enabled": true,
      "Issuer": "https://translate-server.local",
      "Audience": "mcp",
      "SigningKey": "ThisIsADevelopmentSigningKeyForMCPMustBeAtLeast32CharsLong123!",
      "AgentNameClaim": "name"
    },

    // Built-in OAuth clients (for Grok and other tools using full OAuth flow)
    "OAuthClients": [
      {
        "ClientId": "grok-mcp-client",
        "Name": "Grok (xAI)",
        "RedirectUris": [
          "https://grok.x.ai/callback",
          "https://grok.x.ai/oauth/callback"
        ],
        "AllowedScopes": ["mcp:access"]
      }
    ]
  }

  // NOTE: If your backend is behind a reverse proxy that only forwards
  // /api/* and /mcp/*, make sure these paths are also proxied:
  //   - /api/oauth/*
  //   - /api/.well-known/oauth-protected-resource
}
